# ============================================
# RBRY CRYPTO BOT - Environment Configuration
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)
# ============================================

# === Telegram Bot Configuration (REQUIRED) ===
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Your Telegram user ID (owner account)
# Get it from @userinfobot on Telegram
TELEGRAM_OWNER_ID=0

# AI Model APIs (Optional - system degrades gracefully if missing)
# FinBERT can run locally or use these fallbacks
HUGGINGFACE_API_KEY=hf_xxxxx
GROQ_API_KEY=gsk_xxxxx

# Exchange APIs (Optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# CoinGecko (Optional - free tier works without key)
COINGECKO_API_KEY=
# Keyless public access is dynamically rate-limited. Default is a conservative
# 4 requests/minute; only raise this when a keyed plan explicitly allows it.
COINGECKO_RPS=0.0667
COINGECKO_MAX_ATTEMPTS=3
COINGECKO_BATCH_FAILURE_BUDGET=3

# Feature Flags
USE_LOCAL_FINBERT=False  # Local FinBERT needs torch (~2.5GB); cloud inference via Groq/HF is the default
LOG_LEVEL=INFO

# Optional support/contact URL shown on payment fallback screens
SUPPORT_URL=

# Learning System Configuration
FEEDBACK_LOOP_LOOKBACK_DAYS=90      # Days to query for similar patterns
FEEDBACK_LOOP_MIN_SIGNALS=5         # Minimum signals required for adjustment
FEEDBACK_LOOP_CROSS_COIN=False      # Allow learning from other coins

# Performance Configuration
SNAPSHOT_REFRESH_SECONDS=60         # Market snapshot refresh interval
HISTORY_REFRESH_SECONDS=3600        # Daily history refresh interval
HISTORY_DAYS=200                    # Days of daily history for technicals (RSI needs 100+)
SNAPSHOT_MIN_COVERAGE=0.90          # Do not publish thinner market snapshots
HISTORY_MIN_COVERAGE=0.90           # Do not publish thinner history snapshots
SNAPSHOT_WARMUP_GRACE_SECONDS=180   # Initial market warm-up health grace
HISTORY_WARMUP_GRACE_SECONDS=600    # Initial 20-coin history warm-up health grace

# Alerts Configuration
ALERTS_ENABLED=false                # Kill switch: no alert scans unless true
PATTERN_ALERTS_ENABLED=false        # Chart-pattern alerts (no validated edge)
NEWS_ALERTS_ENABLED=false           # Keyword news alerts (off until coin-matched news)
ALERTS_INTERVAL_SECONDS=900         # Alert scan interval (15 min)

# Optional allow-list (comma-separated Telegram ids); empty = open to everyone
ALLOWED_USER_IDS=
