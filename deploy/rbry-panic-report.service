[Unit]
Description=RBRY mass-panic watcher: the week of the paper books in plain words, to the owner on Telegram

# Install with rbry-panic.*: sudo cp deploy/rbry-panic-report.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rbry-panic-report.timer

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/rbry_crypto_bot
ExecStart=/home/ubuntu/rbry_crypto_bot/.venv/bin/python scripts/panic_watch.py report --weekly --notify
Environment=RBRY_ENV_FILE=/home/ubuntu/rbry_crypto_bot/.env.test
Nice=10
MemoryMax=300M
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
