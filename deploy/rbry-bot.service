[Unit]
Description=RBRY CryptoBot (Telegram)
After=network-online.target
Wants=network-online.target
# A revoked token exits with status 1; stop retrying after 5 failures in 5 min.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rbry_crypto_bot
ExecStart=/home/ubuntu/rbry_crypto_bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
